<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-macos</TargetFramework>
        <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
        <!-- Preserve framework code used dynamically by CSV/XML processing in deployment builds. -->
        <TrimMode Condition="'$(Configuration)' == 'Release'">copy</TrimMode>
        <Version>1.5.8</Version>
        <Company>Richardson Oliver Insights, LLC</Company>
        <AssemblyVersion>1.5.8</AssemblyVersion>
        <FileVersion>1.5.8</FileVersion>
        <RootNamespace>CrispLEDES</RootNamespace>
        <AssemblyName>CrispLEDES</AssemblyName>
        <Description>Converts Freshbooks invoices in CSV format to LEDES files</Description>
        <Authors>Richardson Oliver Insights, LLC</Authors>
        <Copyright>Copyright © 2022-2026, Richardson Oliver Insights, LLC, All Rights Reserved</Copyright>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
      <RoiBuildActionsEnableMacNotarizedPackage>true</RoiBuildActionsEnableMacNotarizedPackage>
      <RoiBuildActionsEnableRichardsonOliverMacSigningDefaults>true</RoiBuildActionsEnableRichardsonOliverMacSigningDefaults>
      <RoiBuildActionsMacCodeSignEntitlements>Entitlements.plist</RoiBuildActionsMacCodeSignEntitlements>
      <RoiBuildActionsEnableMacDistributionPackage>true</RoiBuildActionsEnableMacDistributionPackage>
      <RoiBuildActionsMacDistributionPreparationTargets>ReplaceXmlText</RoiBuildActionsMacDistributionPreparationTargets>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="CsvHelper" Version="33.1.0" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="configuration-file.txt" />
      <Content Include="configuration-file.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Include="distribution.xml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <PublishFolderType>None</PublishFolderType>
      </None>
      <Content Remove="background.png"/>
      <None Include="background.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <PublishFolderType>None</PublishFolderType>
      </None>
      <Content Remove="LICENSE.html"/>
      <None Include="LICENSE.html">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <PublishFolderType>None</PublishFolderType>
      </None>
      <Content Remove="README.html"/>
      <None Include="README.html">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <PublishFolderType>None</PublishFolderType>
      </None>
    </ItemGroup>
    <Target Name="ReplaceXmlText" BeforeTargets="_CreateInstaller">
      <PropertyGroup Condition=" '$(DistributionPath)' == '' ">
        <DistributionPath>$(MSBuildProjectDirectory)/$(OutputPath)osx-arm64/</DistributionPath>
      </PropertyGroup>
      <PropertyGroup Condition=" '$(DistributionFile)' == '' ">
        <DistributionFile>$(DistributionPath)distribution.xml</DistributionFile>
      </PropertyGroup>
      <PropertyGroup>
        <RoiBuildActionsMacDistributionFile>$(DistributionFile)</RoiBuildActionsMacDistributionFile>
        <RoiBuildActionsMacDistributionResourcesPath>$(DistributionPath)</RoiBuildActionsMacDistributionResourcesPath>
        <RoiBuildActionsMacComponentPackagePath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutputPath)', 'com.roipatents.crispledes.pkg'))</RoiBuildActionsMacComponentPackagePath>
      </PropertyGroup>
      <XmlPoke XmlInputPath="$(DistributionFile)" Query="/installer-gui-script/title" Value="$(AssemblyName)"/>
      <XmlPoke XmlInputPath="$(DistributionFile)" Query="/installer-gui-script/choice[@id = 'default']/@title" Value="$(AssemblyName)"/>
      <XmlPoke XmlInputPath="$(DistributionFile)" Query="/installer-gui-script/choice[@id = 'default']/@versStr" Value="$(AssemblyVersion)"/>
      <XmlPoke XmlInputPath="$(DistributionFile)" Query="/installer-gui-script/choice[@id = 'com.roipatents.crispledes']/@title" Value="$(AssemblyName)"/>
      <XmlPoke XmlInputPath="$(DistributionFile)" Query="/installer-gui-script/choice[@id = 'com.roipatents.crispledes']/pkg-ref[@id = 'com.roipatents.crispledes']/@version" Value="$(AssemblyVersion)"/>
      <XmlPoke XmlInputPath="$(DistributionFile)" Query="/installer-gui-script/choice[@id = 'com.roipatents.crispledes']/pkg-ref[@id = 'com.roipatents.crispledes']" Value="com.roipatents.crispledes.pkg"/>
    </Target>
    <Import Project="../eng/ROI.BuildActions/1.1.3/ROI.BuildActions.targets" />
</Project>
